# Deployment environment. Must be "production" (or unset -> defaults to
# "development") for JWT_SECRET_KEY / ADMIN_PASSWORD_HASH to be required.
ENVIRONMENT=production

# Backend DB path inside the container
DB_PATH=/data/schedules.db

# JWT signing secret. Required in production — the app refuses to start
# without it. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_SECRET

# Administrative user credentials. ADMIN_PASSWORD_HASH is required in
# production — the app refuses to start without it. Generate with:
#   python -c "import bcrypt; print(bcrypt.hashpw(b'yourpassword', bcrypt.gensalt()).decode())"
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=CHANGE_ME_GENERATE_A_BCRYPT_HASH

# CORS Allowed Origins (comma-separated list, e.g., http://localhost:5173,http://localhost:3000)
ALLOWED_ORIGINS=
