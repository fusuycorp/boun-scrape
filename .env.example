# ==============================================================================
# boun-scrape Environment Configuration
# ==============================================================================

# Application environment ('development', 'test', or 'production')
BOUN_ENVIRONMENT=development

# SQLite database file path
BOUN_DB_PATH=schedules.db

# Upstream Boğaziçi University Portal URLs
BOUN_BASE_URL=https://registration.bogazici.edu.tr
BOUN_QUOTA_URL=https://registration.boun.edu.tr

# Authentication & Tokens
# Generate secret key: python -c "import secrets; print(secrets.token_hex(32))"
BOUN_JWT_SECRET_KEY=change-this-to-a-secure-random-hex-in-production

# Admin credentials
BOUN_ADMIN_USER=admin
# Generate bcrypt hash: python -c "import bcrypt; print(bcrypt.hashpw(b'yourpassword', bcrypt.gensalt()).decode())"
BOUN_ADMIN_PASSWORD_HASH=

# Webhook notifications (for downstream consumers like boun-archive)
BOUN_WEBHOOK_SECRET=
BOUN_WEBHOOK_URLS=

# Scraper Network & Concurrency Tunings
BOUN_MAX_CONCURRENCY=10
BOUN_REQUEST_TIMEOUT=15.0
BOUN_MIN_JITTER=0.05
BOUN_MAX_JITTER=0.20
BOUN_COOKIES_PATH=cookies.txt
BOUN_RECAPTCHA_TOKEN_PATH=recaptcha_token.txt

# Export directory
BOUN_EXPORT_DIR=exports

# CORS allowed origins (comma-separated or JSON list)
BOUN_ALLOWED_ORIGINS=*

# Scheduler Daemon Settings
BOUN_SCRAPER_INTERVAL=3600
# BOUN_SCRAPER_CRON=0 */2 * * *
# BOUN_DEFAULT_TERM=2024/2025-1
BOUN_AUTO_RUN=false
